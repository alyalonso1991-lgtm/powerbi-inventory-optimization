	partition Dim_Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2025,1,1), DATE(2025,12,31)),
				    "FechaKey", INT(FORMAT([Date], "YYYYMMDD")),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "MesNro", MONTH([Date]),
				    "Trimestre", "T" & FORMAT([Date], "Q")
				)

	annotation PBI_Id = 8cb6d6621a324284be942f7e7a743163

